From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Haze <patches@haze.invalid>
Date: Thu, 26 Nov 2026 22:32:50 +0100
Subject: [PATCH] Name the product Haze in every string grit writes

Why: grit keys translations by a fingerprint of the English text, so editing
"Chromium" in the .grd files would orphan the translations of every string that
names the product, German included. Renaming in Translate(), after the
translation is chosen, keeps all ids and locales and leaves the .grd files
untouched; the rules live in //haze/tools/grit/haze_branding.py.
Security-relevant: no
Area: core
---
 tools/grit/grit.pydeps          | 1 +
 tools/grit/grit/node/message.py | 9 ++++++++-
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/tools/grit/grit.pydeps b/tools/grit/grit.pydeps
index 485ef42..d3c3000 100644
--- a/tools/grit/grit.pydeps
+++ b/tools/grit/grit.pydeps
@@ -1,5 +1,6 @@
 # Generated by running:
 #   build/print_python_deps.py --output tools/grit/grit.pydeps --gn-paths tools/grit/grit.py
+//haze/tools/grit/haze_branding.py
 //third_party/catapult/third_party/typ/typ/__init__.py
 //third_party/catapult/third_party/typ/typ/arg_parser.py
 //third_party/catapult/third_party/typ/typ/artifacts.py
diff --git a/tools/grit/grit/node/message.py b/tools/grit/grit/node/message.py
index 74413e1..1e879f3 100644
--- a/tools/grit/grit/node/message.py
+++ b/tools/grit/grit/node/message.py
@@ -4,7 +4,9 @@
 
 '''Handling of the <message> element.'''
 
+import os
 import re
+import sys
 
 from grit.node import base
 
@@ -13,6 +15,10 @@ from grit import exception
 from grit import tclib
 from grit import util
 
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', '..', '..',
+                                '..', 'haze', 'tools', 'grit'))
+import haze_branding
+
 
 # Matches exactly three dots ending a line or followed by whitespace.
 _ELLIPSIS_PATTERN = re.compile(r'(?<!\.)\.\.\.(?=$|\s)')
@@ -284,7 +290,8 @@ class MessageNode(base.ContentNode):
     assert self.clique
     msg = self.clique.MessageForLanguageAndGender(
       lang, gender, self.PseudoIsAllowed(), self.ShouldFallbackToEnglish()
-    ).GetRealContent()
+    )
+    msg = haze_branding.RealContent(msg)
     # Optimization: Avoid the overhead of regular expression substitution if the
     # string clearly does not contain the target '...'.
     if self._replace_ellipsis and '...' in msg:
