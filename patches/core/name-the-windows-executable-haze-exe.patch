From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Haze <patches@haze.invalid>
Date: Thu, 26 Nov 2026 22:39:11 +0100
Subject: [PATCH] Name the Windows executable haze.exe

Why: Windows shows the executable name in Task Manager, firewall prompts and
"Open with", and tools that key on chrome.exe would treat Haze as Chromium or
Chrome. This renames the output and every place that builds, installs, launches
or finds it by name; references to Google Chrome's chrome.exe stay.
Security-relevant: no
Area: core
---
 build/win/reorder-imports.py                           |  6 +++---
 chrome/BUILD.gn                                        | 10 +++++-----
 chrome/app/chrome_exe.ver                              |  4 ++--
 chrome/chrome_proxy/chrome_proxy_main_win.cc           |  2 +-
 chrome/common/chrome_constants.cc                      |  8 ++++----
 .../launcher_support/chrome_launcher_support.cc        |  2 +-
 chrome/installer/mini_installer/BUILD.gn               |  2 +-
 chrome/installer/mini_installer/chrome.release         |  2 +-
 chrome/installer/util/util_constants.h                 |  6 +++---
 components/tracing/common/etw_stack_sampling_win.cc    |  2 +-
 10 files changed, 22 insertions(+), 22 deletions(-)

diff --git a/build/win/reorder-imports.py b/build/win/reorder-imports.py
index 11602df..ba18919 100755
--- a/build/win/reorder-imports.py
+++ b/build/win/reorder-imports.py
@@ -27,8 +27,8 @@ def reorder_imports(input_dir, output_dir, architecture):
     # correct executable in the first place, so that this script
     # only needs to verify that and not write a whole new exe.
 
-    input_image = os.path.join(input_dir, 'chrome.exe')
-    output_image = os.path.join(output_dir, 'chrome.exe')
+    input_image = os.path.join(input_dir, 'haze.exe')
+    output_image = os.path.join(output_dir, 'haze.exe')
 
     # pefile mmap()s the whole executable, and then parses parts of
     # it into python data structures for ease of processing.
@@ -90,7 +90,7 @@ def reorder_imports(input_dir, output_dir, architecture):
 
     pe.write(filename=output_image)
 
-    for fname in glob.iglob(os.path.join(input_dir, 'chrome.exe.*')):
+    for fname in glob.iglob(os.path.join(input_dir, 'haze.exe.*')):
         shutil.copy(fname, os.path.join(output_dir, os.path.basename(fname)))
     return 0
 
diff --git a/chrome/BUILD.gn b/chrome/BUILD.gn
index e11b5bb..38eebfd 100644
--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -87,12 +87,12 @@ if (is_win) {
     # initialexe/ is used so that the we can reorder imports and write back to
     # the final destination at $root_out_dir/.
     inputs = [
-      "$root_out_dir/initialexe/chrome.exe",
-      "$root_out_dir/initialexe/chrome.exe.pdb",
+      "$root_out_dir/initialexe/haze.exe",
+      "$root_out_dir/initialexe/haze.exe.pdb",
     ]
     outputs = [
-      "$root_out_dir/chrome.exe",
-      "$root_out_dir/chrome.exe.pdb",
+      "$root_out_dir/haze.exe",
+      "$root_out_dir/haze.exe.pdb",
     ]
     args = [
       "-i",
@@ -155,7 +155,7 @@ if (!is_android && !is_mac) {
   }
 
   if (is_win) {
-    _chrome_output_name = "initialexe/chrome"
+    _chrome_output_name = "initialexe/haze"
   } else {
     _chrome_output_name = "chrome"
   }
