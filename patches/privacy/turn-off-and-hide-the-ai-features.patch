From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Haze <patches@haze.invalid>
Date: Fri, 27 Nov 2026 12:15:28 +0100
Subject: [PATCH] Turn off and hide the AI features

Why: Haze has no AI features (SPEC section 3), and ungoogled only removes the
model downloads: Gemini in Chrome (Glic, on by default on macOS and Windows),
its actor, "Help me write" (Compose), the NTP compose box and server-side model
execution stay on, and pages see the built-in AI APIs (LanguageModel,
Summarizer, Translator, LanguageDetector). Each is switched off where its
default is defined; the web APIs go from stable to experimental, like their
Writer and Rewriter siblings.
Security-relevant: yes
Security: Touches third_party/blink only to change the status of four
runtime features from stable to experimental, which removes API surface. The
other changes turn features off.
Area: privacy
---
 .../composebox/variations/composebox_fieldtrial.cc     |  2 +-
 chrome/common/chrome_features.cc                       |  4 +-
 components/compose/core/browser/compose_features.cc    |  2 +-
 .../core/optimization_guide_features.cc                |  2 +-
 .../renderer/platform/runtime_enabled_features.json5   | 34 +++++-----
 5 files changed, 22 insertions(+), 22 deletions(-)

diff --git a/chrome/browser/ui/webui/new_tab_page/composebox/variations/composebox_fieldtrial.cc b/chrome/browser/ui/webui/new_tab_page/composebox/variations/composebox_fieldtrial.cc
index cfbc19e..3335702 100644
--- a/chrome/browser/ui/webui/new_tab_page/composebox/variations/composebox_fieldtrial.cc
+++ b/chrome/browser/ui/webui/new_tab_page/composebox/variations/composebox_fieldtrial.cc
@@ -165,7 +165,7 @@ CreateQueryControllerConfigParams() {
   return config_params;
 }
 
-BASE_FEATURE(kNtpComposebox, base::FEATURE_ENABLED_BY_DEFAULT);
+BASE_FEATURE(kNtpComposebox, base::FEATURE_DISABLED_BY_DEFAULT);
 
 const base::FeatureParam<std::string> kConfigParam(&kNtpComposebox,
                                                    "NtpComposeboxConfigParam",
diff --git a/chrome/common/chrome_features.cc b/chrome/common/chrome_features.cc
index ddb54a1..3e3e85a 100644
--- a/chrome/common/chrome_features.cc
+++ b/chrome/common/chrome_features.cc
@@ -241,7 +241,7 @@ BASE_FEATURE(kForcedAppRelaunchOnPlaceholderUpdate,
 #endif  // BUILDFLAG(IS_CHROMEOS)
 
 // Controls whether the actor component of Glic is enabled.
-BASE_FEATURE(kGlicActor, base::FEATURE_ENABLED_BY_DEFAULT);
+BASE_FEATURE(kGlicActor, base::FEATURE_DISABLED_BY_DEFAULT);
 
 BASE_FEATURE(kGlicActorApcComparison, base::FEATURE_ENABLED_BY_DEFAULT);
 
@@ -528,7 +528,7 @@ BASE_FEATURE(kGlicMessageFirstFre, base::FEATURE_DISABLED_BY_DEFAULT);
 BASE_FEATURE(kGlic,
 #if BUILDFLAG(IS_MAC) || BUILDFLAG(IS_WIN) || BUILDFLAG(IS_CHROMEOS) || \
     BUILDFLAG(IS_ANDROID)
-             base::FEATURE_ENABLED_BY_DEFAULT
+             base::FEATURE_DISABLED_BY_DEFAULT
 #else
              base::FEATURE_DISABLED_BY_DEFAULT
 #endif
diff --git a/components/compose/core/browser/compose_features.cc b/components/compose/core/browser/compose_features.cc
index bc0d7b5..0f37566 100644
